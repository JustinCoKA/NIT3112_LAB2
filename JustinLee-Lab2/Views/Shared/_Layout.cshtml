<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] · QuTech</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" /></head>
<body><a href="#main" class="skip-link">Skip to content</a>
<aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">Q</span> QuTech<span class="brand-caption">SERVICE ADMINISTRATION</span></a><p class="nav-label">WORKSPACE</p><nav aria-label="Main navigation"><a asp-controller="Home" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Home" && ("Home" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Overview</a>
<a asp-controller="Customers" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Customers" && ("Customers" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Customers</a>
<a asp-controller="Subscriptions" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Subscriptions" && ("Subscriptions" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Subscriptions</a>
<a asp-controller="Plans" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Plans" && ("Plans" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Plans</a>
<a asp-controller="Modules" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Modules" && ("Modules" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Modules</a>
<a asp-controller="Discounts" asp-action="Index">Discounts</a>
<a asp-controller="Configuration" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Configuration" && ("Configuration" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Configuration</a>
<a asp-controller="Usage" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Usage" && ("Usage" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Usage</a>
<a asp-controller="Invoices" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Invoices" && ("Invoices" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Invoices</a>
<a asp-controller="Home" asp-action="Analytics" class="@((string)ViewContext.RouteData.Values["controller"] == "Home" && ("Home" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Analytics") ? "active" : "")">Analytics</a>
<a asp-controller="Administrators" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Administrators" && ("Administrators" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Administrators</a>
<a asp-controller="Audit" asp-action="Index" class="@((string)ViewContext.RouteData.Values["controller"] == "Audit" && ("Audit" != "Home" || (string)ViewContext.RouteData.Values["action"] == "Index") ? "active" : "")">Audit trail</a>
<a asp-controller="Home" asp-action="About" class="@((string)ViewContext.RouteData.Values["controller"] == "Home" && ("Home" != "Home" || (string)ViewContext.RouteData.Values["action"] == "About") ? "active" : "")">About</a></nav><div class="sidebar-footer">Justin Lee<br /><span>NIT3112 · Lab 3</span></div></aside>
<div class="workspace"><header class="topbar"><span>QuTech / @ViewData["Title"]</span><form method="post" asp-controller="Account" asp-action="Logout"><span>@User.Identity.Name</span> <button class="button secondary" type="submit">Sign out</button></form></header><main id="main">@if(TempData["Success"] != null) { <div class="notice success" role="status">@TempData["Success"]</div> } @if(TempData["Error"] != null) { <div class="notice" role="alert">@TempData["Error"]</div> }@RenderBody()</main><footer>QuTech SaaS administration · Lab 3 · All prices in AUD</footer></div>
</body></html>
