@model Administrator
@{ ViewData["Title"] = "Administrators details"; }
<a class="back" asp-action="Index">← Back to administrators</a>
@if (ViewBag.IsPreview == true) { <div class="notice success" role="status"><strong>Validation passed.</strong> This is a preview of your input. No record has been saved.</div> }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATORS</p><h1>@Model.FullName</h1></div></div>
<section class="panel"><dl class="details"><div><dt>Department</dt><dd>@Model.Department</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Phone</dt><dd>@Model.Phone</dd></div></dl></section>
@if (ViewBag.IsPreview != true) {<section class="panel"><h2>Recorded activity</h2>@foreach (var entry in Model.AuditEntries) {<p>@entry.OccurredAt?.ToString("dd MMM yyyy HH:mm") · @entry.Action</p>}</section>}
