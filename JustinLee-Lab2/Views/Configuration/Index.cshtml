@model List<PlanModule>
@{ ViewData["Title"] = "Module configuration"; }
<div class="page-heading"><div><p class="eyebrow">QUTECH ADMINISTRATION</p><h1>Module configuration</h1><p>Plan-to-module assignments define the capabilities offered by each tier.</p></div><a class="button" asp-action="Create">+ New record</a></div><div class="table-wrap"><table><thead><tr><th scope="col">Plan</th><th scope="col">Module</th><th scope="col">Availability</th></tr></thead><tbody>@foreach (var item in Model) {<tr><td><a asp-controller="Plans" asp-action="Details" asp-route-id="@item.PlanId">@item.Plan.Name</a></td><td>@item.Module.Name</td><td>@(item.Enabled ? "Enabled" : "Disabled")</td></tr>}</tbody></table></div>
