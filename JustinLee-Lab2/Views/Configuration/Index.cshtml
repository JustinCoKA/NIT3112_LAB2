@model List<PlanModule>
@{ ViewData["Title"] = "Configuration"; }
<div class="page-heading"><div><h1>Plan configuration</h1><p>Control which capabilities each subscription tier includes.</p></div><a class="button" asp-action="Create">Configure module</a></div>
<div class="table-wrap"><table><thead><tr><th>Plan</th><th>Module</th><th>Availability</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td>@item.Plan.Name</td><td>@item.Module.Name</td><td>@(item.Enabled ? "Enabled" : "Disabled")</td><td><form method="post" asp-action="Delete"><input type="hidden" name="planId" value="@item.PlanId"/><input type="hidden" name="moduleId" value="@item.ModuleId"/><button class="button secondary" type="submit">Remove assignment</button></form></td></tr> }</tbody></table></div>