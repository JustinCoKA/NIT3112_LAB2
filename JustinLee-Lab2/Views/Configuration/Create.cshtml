@model PlanModule
@{ ViewData["Title"] = "Configure modules"; }
<a class="back" asp-action="Index">Back to configuration</a><h1>Configure module availability</h1><p>A plan can contain several modules. Selecting an existing pair updates its availability.</p>
<form class="form-panel" method="post" asp-action="Create"><div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="field"><label asp-for="PlanId">Plan</label><select asp-for="PlanId"><option value="">Choose a plan</option>@foreach(var item in ViewBag.Plans) { <option value="@item.Id">@item.Name</option> }</select></div>
<div class="field"><label asp-for="ModuleId">Module</label><select asp-for="ModuleId"><option value="">Choose a module</option>@foreach(var item in ViewBag.Modules) { <option value="@item.Id">@item.Name</option> }</select></div>
<div class="field"><label asp-for="Enabled">Available in this plan</label><select asp-for="Enabled"><option value="true">Enabled</option><option value="false">Disabled</option></select></div><button class="button" type="submit">Save configuration</button></form>