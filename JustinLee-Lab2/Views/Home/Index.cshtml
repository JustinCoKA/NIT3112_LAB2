@model DashboardViewModel
@{ ViewData["Title"] = "Overview"; }
<div class="page-heading"><div><p class="eyebrow">YOUR SERVICE AT A GLANCE</p><h1>Platform overview</h1><p>A clear view of customers, subscriptions and billing.</p></div><a class="button" asp-controller="Customers" asp-action="Create">+ New customer</a></div>
<div class="metrics"><article><span>Customer organisations</span><strong>@Model.CustomerCount</strong><a asp-controller="Customers" asp-action="Index">View customers →</a></article><article><span>Active subscriptions</span><strong>@Model.ActiveSubscriptions</strong><a asp-controller="Subscriptions" asp-action="Index">Review plans →</a></article><article><span>Monthly recurring revenue</span><strong><small>AUD</small> @Model.MonthlyRevenue.ToString("N0")</strong><span>Active plan prices, excluding trials</span></article><article><span>Outstanding invoices</span><strong><small>AUD</small> @Model.UnpaidAmount.ToString("N0")</strong><a asp-controller="Invoices" asp-action="Index">Review billing →</a></article></div>
<section class="panel"><div class="section-heading"><div><p class="eyebrow">CUSTOMER OPERATIONS</p><h2>Current subscriptions</h2></div><a asp-controller="Subscriptions" asp-action="Index">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Organisation</th><th>Plan</th><th>Monthly price (AUD)</th><th>Status</th><th>Details</th></tr></thead><tbody>@foreach (var subscription in Model.Subscriptions) {<tr><td>@subscription.Customer.CompanyName</td><td>@subscription.Plan.Name</td><td>@subscription.Plan.MonthlyPrice?.ToString("N2")</td><td><span class="status">@subscription.Status</span></td><td><a asp-controller="Subscriptions" asp-action="Details" asp-route-id="@subscription.Id">Review →</a></td></tr>}</tbody></table></div></section>
<div class="split"><section class="panel"><p class="eyebrow">BILLING FOLLOW-UP</p><h2>Invoices awaiting payment</h2>@foreach (var invoice in Model.OpenInvoices) {<div class="invoice-line"><div><a asp-controller="Invoices" asp-action="Details" asp-route-id="@invoice.Id">@invoice.Reference</a><p>@invoice.Subscription.Customer.CompanyName</p></div><strong>AUD @invoice.Amount?.ToString("N2")</strong></div>}</section><section class="panel accent"><p class="eyebrow">SERVICE CATALOGUE</p><h2>Built for the next stage</h2><p>Review Starter, Growth and Scale plans. Match each customer with the modules and API allowance they need.</p><a class="button secondary" asp-controller="Plans" asp-action="Index">Explore subscription plans →</a></section></div>
