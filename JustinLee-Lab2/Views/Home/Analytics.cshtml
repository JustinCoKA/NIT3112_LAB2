@model DashboardViewModel
@{ ViewData["Title"] = "Analytics"; }
<div class="page-heading"><div><p class="eyebrow">BUSINESS INSIGHTS</p><h1>Subscription analytics</h1><p>September 2026 sample usage and current plan performance.</p></div></div>
<div class="metrics"><article><span>Total sample API calls</span><strong>@Model.ApiCalls.ToString("N0")</strong></article><article><span>Active subscriptions</span><strong>@Model.ActiveSubscriptions</strong></article><article><span>Monthly recurring revenue</span><strong><small>AUD</small> @Model.MonthlyRevenue.ToString("N0")</strong></article><article><span>Unpaid invoice value</span><strong><small>AUD</small> @Model.UnpaidAmount.ToString("N0")</strong></article></div>
<section class="panel"><h2>Usage against monthly allowance</h2><p>Each row compares one customer's September API calls with their plan allowance.</p><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Plan</th><th>API calls</th><th>Allowance</th><th>Consumption</th></tr></thead><tbody>@foreach (var subscription in Model.Subscriptions) { @foreach (var usage in subscription.UsageRecords) {<tr><td>@subscription.Customer.CompanyName</td><td>@subscription.Plan.Name</td><td>@usage.ApiCalls?.ToString("N0")</td><td>@subscription.Plan.IncludedApiCalls?.ToString("N0")</td><td><meter min="0" max="@subscription.Plan.IncludedApiCalls" value="@usage.ApiCalls">@usage.ApiCalls API calls</meter></td></tr>} }</tbody></table></div></section>
<p class="notice">Revenue is the sum of active monthly plan prices. Trial subscriptions are excluded. Amounts are illustrative AUD values, with no tax or proration calculation.</p>
