@model List<UsageRecord>
@{ ViewData["Title"] = "Analytics"; }
<div class="page-heading"><div><h1>Service analytics</h1><p>Usage records and billing totals across all stored reporting periods.</p></div></div>
<div class="metrics"><article><span>Recorded API calls</span><strong>@ViewBag.TotalCalls.ToString("N0")</strong></article><article><span>Total billed AUD</span><strong>@ViewBag.Billed.ToString("N2")</strong></article><article><span>Paid invoices AUD</span><strong>@ViewBag.Paid.ToString("N2")</strong></article><article><span>Discounts granted AUD</span><strong>@ViewBag.Discounts.ToString("N2")</strong></article></div>
<section class="panel"><h2>Usage against plan allowance</h2><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Period</th><th>API calls</th><th>Allowance</th><th>Utilisation</th></tr></thead><tbody>@foreach(var item in Model) { var allowance = item.Subscription.Plan.IncludedApiCalls ?? 1; var percent = (decimal)(item.ApiCalls ?? 0) / allowance * 100; <tr><td>@item.Subscription.Customer.CompanyName</td><td>@item.PeriodStart?.ToString("yyyy-MM")</td><td>@item.ApiCalls</td><td>@allowance</td><td>@percent.ToString("N1")%</td></tr> }</tbody></table></div></section><p>Allowance comparisons use the subscription's current plan. Historical invoice amounts remain fixed snapshots.</p>