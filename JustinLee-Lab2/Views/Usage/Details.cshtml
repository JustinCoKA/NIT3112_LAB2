@model UsageRecord
@{ ViewData["Title"] = "UsageRecord details"; }
<a class="back" asp-action="Index">Back to usage</a><div class="page-heading"><h1>UsageRecord details</h1><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit</a></div>
<section class="panel"><dl class="details"><div><dt>Subscription</dt><dd>@Model.SubscriptionId</dd></div><div><dt>Reporting month</dt><dd>@Model.PeriodStart</dd></div><div><dt>API calls</dt><dd>@Model.ApiCalls</dd></div></dl></section>