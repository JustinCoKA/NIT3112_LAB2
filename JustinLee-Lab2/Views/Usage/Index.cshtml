@model List<UsageRecord>
@{ ViewData["Title"] = "Usage"; }
<div class="page-heading"><div><p class="eyebrow">QUTECH OPERATIONS</p><h1>Usage</h1><p>Manage the stored usage for your SaaS service.</p></div><a class="button" asp-action="Create">New UsageRecord</a></div>
<div class="table-wrap"><table><thead><tr><th>Customer</th><th>Month</th><th>API calls</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td>@item.Subscription.Customer.CompanyName</td><td>@item.PeriodStart?.ToString("yyyy-MM")</td><td>@item.ApiCalls?.ToString("N0")</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> · <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }</tbody></table></div>
@if(Model.Count == 0) { <p>No records yet. Create the first record above.</p> }