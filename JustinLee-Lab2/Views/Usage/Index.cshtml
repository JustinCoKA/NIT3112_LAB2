@model List<UsageRecord>
@{ ViewData["Title"] = "Usage records"; }
<div class="page-heading"><div><p class="eyebrow">QUTECH ADMINISTRATION</p><h1>Usage records</h1><p>September 2026 sample API consumption, recorded by subscription.</p></div><a class="button" asp-action="Create">+ New record</a></div><div class="table-wrap"><table><thead><tr><th scope="col">Customer</th><th scope="col">Period</th><th scope="col">API calls</th><th scope="col">Monthly allowance</th><th scope="col"></th></tr></thead><tbody>@foreach (var item in Model) {<tr><td>@item.Subscription.Customer.CompanyName</td><td>@item.PeriodStart?.ToString("MMM yyyy")</td><td>@item.ApiCalls?.ToString("N0")</td><td>@item.Subscription.Plan.IncludedApiCalls?.ToString("N0")</td><td><a asp-action="Details" asp-route-id="@item.Id">View usage →</a></td></tr>}</tbody></table></div>
