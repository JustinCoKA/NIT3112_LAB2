@model BillingProfile
@{ ViewData["Title"] = "Billing profile"; }
<a class="back" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">Back to customer</a><h1>Billing profile</h1><p>Update the invoice destination for this customer.</p>
<form class="form-panel" method="post" asp-action="Edit" asp-route-id="@Model.CustomerId"><div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="field"><label asp-for="BillingName">Billing name</label><input asp-for="BillingName"/><span asp-validation-for="BillingName" class="validation"></span></div>
<div class="field"><label asp-for="BillingEmail">Billing email</label><input asp-for="BillingEmail" type="email"/><span asp-validation-for="BillingEmail" class="validation"></span></div>
<div class="field"><label asp-for="Address">Billing address</label><textarea asp-for="Address" rows="3"></textarea><span asp-validation-for="Address" class="validation"></span></div><button class="button" type="submit">Save billing profile</button></form>