@model Invoice
@{ ViewData["Title"] = "Invoice " + Model.Reference; }
<a class="back" asp-action="Index">Back to invoices</a><div class="page-heading"><div><p class="eyebrow">QUTECH BILLING</p><h1>@Model.Reference</h1><p>@Model.Status · Billing month @Model.PeriodStart?.ToString("yyyy-MM")</p></div><button class="button secondary no-print" type="button" onclick="window.print()">Print invoice</button></div>
<section class="panel"><h2>@Model.Subscription.Customer.BillingProfile.BillingName</h2><p>@Model.Subscription.Customer.BillingProfile.Address<br/>@Model.Subscription.Customer.BillingProfile.BillingEmail</p><dl class="details"><div><dt>Issued</dt><dd>@Model.IssuedOn?.ToString("dd MMM yyyy")</dd></div><div><dt>Due</dt><dd>@Model.DueOn?.ToString("dd MMM yyyy")</dd></div><div><dt>Plan</dt><dd>@Model.Subscription.Plan.Name</dd></div><div><dt>Subscription</dt><dd>#@Model.SubscriptionId</dd></div></dl></section>
<section class="panel"><table><tbody><tr><th>Monthly charge</th><td>AUD @Model.Subtotal.ToString("N2")</td></tr><tr><th>Discount</th><td>AUD @Model.DiscountAmount.ToString("N2")</td></tr><tr><th>Total payable</th><td><strong>AUD @Model.Amount?.ToString("N2")</strong></td></tr></tbody></table><p>Recorded amounts are fixed when this invoice is generated. No tax or proration is included.</p></section>
@if(Model.Status != "Paid") { <form class="no-print" method="post" asp-action="MarkPaid" asp-route-id="@Model.Id"><button class="button" type="submit">Mark as paid</button><p>Record a received payment. This action does not charge a payment card.</p></form> }