@model List<Invoice>
@{ ViewData["Title"] = "Invoices"; }
<div class="page-heading"><div><h1>Invoices</h1><p>Review monthly charges and record payment status.</p></div><a class="button" asp-action="Create">Generate invoice</a></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Customer</th><th>Billing month</th><th>Amount AUD</th><th>Status</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Reference</a></td><td>@item.Subscription.Customer.CompanyName</td><td>@item.PeriodStart?.ToString("yyyy-MM")</td><td>@item.Amount?.ToString("N2")</td><td><span class="status">@item.Status</span></td></tr> }</tbody></table></div>