@model List<Invoice>
@{ ViewData["Title"] = "Invoices"; }
<div class="page-heading"><div><p class="eyebrow">QUTECH ADMINISTRATION</p><h1>Invoices</h1><p>Review billing references, due dates and payment status. All amounts are AUD.</p></div><a class="button" asp-action="Create">+ New record</a></div><div class="table-wrap"><table><thead><tr><th scope="col">Reference</th><th scope="col">Customer</th><th scope="col">Due date</th><th scope="col">Amount (AUD)</th><th scope="col">Status</th></tr></thead><tbody>@foreach (var item in Model) {<tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Reference</a></td><td>@item.Subscription.Customer.CompanyName</td><td>@item.DueOn?.ToString("dd MMM yyyy")</td><td>@item.Amount?.ToString("N2")</td><td><span class="status">@item.Status</span></td></tr>}</tbody></table></div>
