@model Invoice
@{ ViewData["Title"] = "Generate invoice"; }
<a class="back" asp-action="Index">Back to invoices</a><h1>Generate monthly invoice</h1><p>The selected plan price and eligible discount determine the amount. Each subscription can be invoiced once per month.</p>
<form class="form-panel" method="post" asp-action="Create"><div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="field"><label asp-for="SubscriptionId">Active subscription</label><select asp-for="SubscriptionId"><option value="">Choose a subscription</option>@foreach(var item in ViewBag.Subscriptions) { <option value="@item.Id">@item.Customer.CompanyName · @item.Plan.Name · AUD @item.Plan.MonthlyPrice</option> }</select></div>
<div class="field"><label asp-for="PeriodStart">Billing month first day</label><input asp-for="PeriodStart" type="date" asp-format="{0:yyyy-MM-dd}"/></div>
<div class="field"><label asp-for="IssuedOn">Issue date</label><input asp-for="IssuedOn" type="date" asp-format="{0:yyyy-MM-dd}"/></div>
<div class="field"><label asp-for="DueOn">Due date</label><input asp-for="DueOn" type="date" asp-format="{0:yyyy-MM-dd}"/></div><button class="button" type="submit">Generate invoice</button></form>
<p class="notice">Charges are a full monthly plan fee, excluding tax and proration. Discounts apply when enabled and valid on the first day of the billing month.</p>