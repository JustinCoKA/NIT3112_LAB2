@model Invoice
@{ ViewData["Title"] = "New Invoice"; }
<a class="back" asp-action="Index">← Back to invoices</a>
<div class="page-heading"><div><p class="eyebrow">INVOICES</p><h1>New invoice</h1><p>Enter the details below to preview this record.</p></div></div>
<p class="notice">Preview only. Valid submissions are displayed for review and are not saved.</p>
<form asp-action="Create" method="post" class="form-panel">
    @if (!ViewData.ModelState.IsValid) { <p class="validation" role="alert">Please correct the highlighted fields and preview again.</p> }
    <div class="field"><label asp-for="Reference">Invoice reference</label><input asp-for="Reference" type="text" /><span asp-validation-for="Reference" class="validation"></span></div><div class="field"><label asp-for="SubscriptionId">Subscription</label><select asp-for="SubscriptionId"><option value="">Select subscription</option>@foreach (var item in ViewBag.Subscriptions) { <option value="@item.Id">@item.Customer.CompanyName (#@item.Id)</option> }</select>@if (ViewData.ModelState.GetValidationState("SubscriptionId") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Choose an existing subscription from the list.</span> }</div><div class="field"><label asp-for="IssuedOn">Issue date</label><input asp-for="IssuedOn" type="date" />@if (ViewData.ModelState.GetValidationState("IssuedOn") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Enter a valid invoice issue date.</span> }</div><div class="field"><label asp-for="DueOn">Due date</label><input asp-for="DueOn" type="date" />@if (ViewData.ModelState.GetValidationState("DueOn") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Enter a valid due date on or after the issue date.</span> }</div><div class="field"><label asp-for="Amount">Amount (AUD)</label><input asp-for="Amount" type="number" step="0.01" />@if (ViewData.ModelState.GetValidationState("Amount") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Enter an invoice amount of zero or more in AUD.</span> }</div><div class="field"><label asp-for="Status">Status</label><select asp-for="Status"><option value="">Select status</option><option>Draft</option><option>Unpaid</option><option>Paid</option></select><span asp-validation-for="Status" class="validation"></span></div>
    <div class="form-actions"><button type="submit" class="button">Validate &amp; preview</button><a asp-action="Index">Cancel</a></div>
</form>
