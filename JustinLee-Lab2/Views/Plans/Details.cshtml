@model Plan
@{ ViewData["Title"] = "Plan details"; }
<a class="back" asp-action="Index">Back to plans</a><div class="page-heading"><h1>Plan details</h1><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit</a></div>
<section class="panel"><dl class="details"><div><dt>Plan name</dt><dd>@Model.Name</dd></div><div><dt>Description</dt><dd>@Model.Description</dd></div><div><dt>Monthly price AUD</dt><dd>@Model.MonthlyPrice</dd></div><div><dt>Included API calls</dt><dd>@Model.IncludedApiCalls</dd></div></dl></section>