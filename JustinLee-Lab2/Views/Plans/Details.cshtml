@model Plan
@{ ViewData["Title"] = "Plans details"; }
<a class="back" asp-action="Index">← Back to plans</a>
@if (ViewBag.IsPreview == true) { <div class="notice success" role="status"><strong>Validation passed.</strong> This is a preview of your input. No record has been saved.</div> }
<div class="page-heading"><div><p class="eyebrow">PLANS</p><h1>@Model.Name</h1></div></div>
<section class="panel"><dl class="details"><div><dt>Description</dt><dd>@Model.Description</dd></div><div><dt>Monthly price (AUD)</dt><dd>@Model.MonthlyPrice?.ToString("N2")</dd></div><div><dt>Monthly API allowance</dt><dd>@Model.IncludedApiCalls?.ToString("N0")</dd></div></dl></section>
@if (ViewBag.IsPreview != true) {<section class="panel"><div class="section-heading"><h2>Module configuration</h2><a asp-controller="Configuration" asp-action="Index">Configure modules →</a></div>@foreach (var link in Model.PlanModules) {<p><a asp-controller="Modules" asp-action="Details" asp-route-id="@link.ModuleId">@link.Module.Name</a> · @(link.Enabled ? "Enabled" : "Disabled")</p>}</section>}
