@model Plan
@{ ViewData["Title"] = "New Plan"; }
<a class="back" asp-action="Index">← Back to plans</a>
<div class="page-heading"><div><p class="eyebrow">PLANS</p><h1>New plan</h1><p>Enter the details below to preview this record.</p></div></div>
<p class="notice">Preview only. Valid submissions are displayed for review and are not saved.</p>
<form asp-action="Create" method="post" class="form-panel">
    @if (!ViewData.ModelState.IsValid) { <p class="validation" role="alert">Please correct the highlighted fields and preview again.</p> }
    <div class="field"><label asp-for="Name">Plan name</label><input asp-for="Name" type="text" /><span asp-validation-for="Name" class="validation"></span></div><div class="field"><label asp-for="Description">Description</label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description" class="validation"></span></div><div class="field"><label asp-for="MonthlyPrice">Monthly price (AUD)</label><input asp-for="MonthlyPrice" type="number" step="0.01" />@if (ViewData.ModelState.GetValidationState("MonthlyPrice") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Enter a monthly price of zero or more in AUD.</span> }</div><div class="field"><label asp-for="IncludedApiCalls">Monthly API allowance</label><input asp-for="IncludedApiCalls" type="number" />@if (ViewData.ModelState.GetValidationState("IncludedApiCalls") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Enter a whole number of at least one API call.</span> }</div>
    <div class="form-actions"><button type="submit" class="button">Validate &amp; preview</button><a asp-action="Index">Cancel</a></div>
</form>
