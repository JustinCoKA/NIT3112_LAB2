@model List<Subscription>
@{ ViewData["Title"] = "Subscriptions"; }
<div class="page-heading"><div><p class="eyebrow">QUTECH OPERATIONS</p><h1>Subscriptions</h1><p>Manage the stored subscriptions for your SaaS service.</p></div><a class="button" asp-action="Create">New Subscription</a></div>
<div class="table-wrap"><table><thead><tr><th>Customer</th><th>Plan</th><th>Discount</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td>@item.Customer.CompanyName</td><td>@item.Plan.Name</td><td>@(item.Discount?.Name ?? "None")</td><td>@item.Status</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> · <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }</tbody></table></div>
@if(Model.Count == 0) { <p>No records yet. Create the first record above.</p> }