@model List<Subscription>
@{ ViewData["Title"] = "Subscriptions"; }
<div class="page-heading"><div><p class="eyebrow">QUTECH ADMINISTRATION</p><h1>Subscriptions</h1><p>Review customer plans, lifecycle status and service start dates.</p></div><a class="button" asp-action="Create">+ New record</a></div><div class="table-wrap"><table><thead><tr><th scope="col">Customer</th><th scope="col">Plan</th><th scope="col">Start date</th><th scope="col">Status</th><th scope="col"></th></tr></thead><tbody>@foreach (var item in Model) {<tr><td>@item.Customer.CompanyName</td><td>@item.Plan.Name</td><td>@item.StartDate?.ToString("dd MMM yyyy")</td><td><span class="status">@item.Status</span></td><td><a asp-action="Details" asp-route-id="@item.Id">View subscription →</a></td></tr>}</tbody></table></div>
