@model Subscription
@{ ViewData["Title"] = "Subscription details"; }
<a class="back" asp-action="Index">Back to subscriptions</a><div class="page-heading"><h1>Subscription details</h1><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit</a></div>
<section class="panel"><dl class="details"><div><dt>Customer</dt><dd>@Model.CustomerId</dd></div><div><dt>Plan</dt><dd>@Model.PlanId</dd></div><div><dt>Discount optional</dt><dd>@Model.DiscountId</dd></div><div><dt>Start date</dt><dd>@Model.StartDate</dd></div><div><dt>Status</dt><dd>@Model.Status</dd></div></dl></section>