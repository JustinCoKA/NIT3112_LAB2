@model Subscription
@{ ViewData["Title"] = "New Subscription"; }
<a class="back" asp-action="Index">← Back to subscriptions</a>
<div class="page-heading"><div><p class="eyebrow">SUBSCRIPTIONS</p><h1>New subscription</h1><p>Enter the details below to preview this record.</p></div></div>
<p class="notice">Preview only. Valid submissions are displayed for review and are not saved.</p>
<form asp-action="Create" method="post" class="form-panel">
    @if (!ViewData.ModelState.IsValid) { <p class="validation" role="alert">Please correct the highlighted fields and preview again.</p> }
    <div class="field"><label asp-for="CustomerId">Customer</label><select asp-for="CustomerId"><option value="">Select customer</option>@foreach (var item in ViewBag.Customers) { <option value="@item.Id">@item.CompanyName (#@item.Id)</option> }</select>@if (ViewData.ModelState.GetValidationState("CustomerId") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Choose an existing customer from the list.</span> }</div><div class="field"><label asp-for="PlanId">Plan</label><select asp-for="PlanId"><option value="">Select plan</option>@foreach (var item in ViewBag.Plans) { <option value="@item.Id">@item.Name (#@item.Id)</option> }</select>@if (ViewData.ModelState.GetValidationState("PlanId") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Choose an existing subscription plan from the list.</span> }</div><div class="field"><label asp-for="StartDate">Start date</label><input asp-for="StartDate" type="date" />@if (ViewData.ModelState.GetValidationState("StartDate") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid) { <span class="validation">Enter a valid subscription start date.</span> }</div><div class="field"><label asp-for="Status">Status</label><select asp-for="Status"><option value="">Select status</option><option>Active</option><option>Trial</option><option>Paused</option></select><span asp-validation-for="Status" class="validation"></span></div>
    <div class="form-actions"><button type="submit" class="button">Validate &amp; preview</button><a asp-action="Index">Cancel</a></div>
</form>
