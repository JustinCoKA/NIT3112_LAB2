@model List<AuditEntry>
@{ ViewData["Title"] = "Audit trail"; }
<h1>Audit trail</h1><p>Read-only history of administrator actions. Times are shown in UTC.</p><div class="table-wrap"><table><thead><tr><th>Time UTC</th><th>Administrator</th><th>Action</th><th>Target</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td>@item.OccurredAt?.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@item.Administrator.FullName</td><td>@item.Action</td><td>@item.Target</td></tr> }</tbody></table></div>