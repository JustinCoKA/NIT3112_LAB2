@model Customer
@{ var editing = Model.Id != 0; ViewData["Title"] = editing ? "Edit Customer" : "New Customer"; }
<a class="back" asp-action="Index">Back to customers</a><h1>@ViewData["Title"]</h1><p>Save valid business information to the QuTech database.</p>
<form class="form-panel" method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : (int?)null)">
<input type="hidden" asp-for="Id"/><div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="field"><label asp-for="FullName">Full name</label><input asp-for="FullName" type="text"/><span asp-validation-for="FullName" class="validation"></span></div>
<div class="field"><label asp-for="CompanyName">Company name</label><input asp-for="CompanyName" type="text"/><span asp-validation-for="CompanyName" class="validation"></span></div>
<div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email"/><span asp-validation-for="Email" class="validation"></span></div>
<div class="field"><label asp-for="Phone">Phone</label><input asp-for="Phone" type="tel"/><span asp-validation-for="Phone" class="validation"></span></div>
@if (!editing) { <div class="field"><label for="billingAddress">Billing address</label><input id="billingAddress" name="billingAddress" value="@(Context.Request.HasFormContentType ? Context.Request.Form["billingAddress"].ToString() : "")" maxlength="200"/><span class="validation">@Html.ValidationMessage("billingAddress")</span></div> }<div class="form-actions"><button class="button" type="submit">Save</button><a asp-action="Index">Cancel</a></div></form>