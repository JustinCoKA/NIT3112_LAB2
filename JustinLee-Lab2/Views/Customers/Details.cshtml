@model Customer
@{ ViewData["Title"] = "Customer details"; }
<a class="back" asp-action="Index">Back to customers</a><div class="page-heading"><h1>Customer details</h1><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit</a></div>
<section class="panel"><dl class="details"><div><dt>Full name</dt><dd>@Model.FullName</dd></div><div><dt>Company name</dt><dd>@Model.CompanyName</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Phone</dt><dd>@Model.Phone</dd></div></dl><p><a asp-controller="BillingProfiles" asp-action="Edit" asp-route-id="@Model.Id">Manage billing profile</a></p></section>