@model Customer
@{ ViewData["Title"] = "New Customer"; }
<a class="back" asp-action="Index">← Back to customers</a>
<div class="page-heading"><div><p class="eyebrow">CUSTOMERS</p><h1>New customer</h1><p>Enter the details below to preview this record.</p></div></div>
<p class="notice">Preview only. Valid submissions are displayed for review and are not saved.</p>
<form asp-action="Create" method="post" class="form-panel">
    @if (!ViewData.ModelState.IsValid) { <p class="validation" role="alert">Please correct the highlighted fields and preview again.</p> }
    <div class="field"><label asp-for="FullName">Contact name</label><input asp-for="FullName" type="text" /><span asp-validation-for="FullName" class="validation"></span></div><div class="field"><label asp-for="CompanyName">Organisation</label><input asp-for="CompanyName" type="text" /><span asp-validation-for="CompanyName" class="validation"></span></div><div class="field"><label asp-for="Email">Contact email</label><input asp-for="Email" type="email" /><span asp-validation-for="Email" class="validation"></span></div><div class="field"><label asp-for="Phone">Phone</label><input asp-for="Phone" type="tel" /><span asp-validation-for="Phone" class="validation"></span></div>
    <div class="form-actions"><button type="submit" class="button">Validate &amp; preview</button><a asp-action="Index">Cancel</a></div>
</form>
