@model List<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="page-heading"><div><p class="eyebrow">QUTECH ADMINISTRATION</p><h1>Customers</h1><p>Customer organisations and the people who manage their subscriptions.</p></div><a class="button" asp-action="Create">+ New record</a></div><div class="table-wrap"><table><thead><tr><th scope="col">Organisation</th><th scope="col">Contact</th><th scope="col">Email</th><th scope="col">Subscriptions</th></tr></thead><tbody>@foreach (var item in Model) {<tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.CompanyName</a></td><td>@item.FullName</td><td>@item.Email</td><td>@item.Subscriptions.Count</td></tr>}</tbody></table></div>
