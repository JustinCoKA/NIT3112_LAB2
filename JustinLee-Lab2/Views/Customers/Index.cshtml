@model List<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="page-heading"><div><p class="eyebrow">QUTECH OPERATIONS</p><h1>Customers</h1><p>Manage the stored customers for your SaaS service.</p></div><a class="button" asp-action="Create">New Customer</a></div>
<div class="table-wrap"><table><thead><tr><th>Full name</th><th>Company name</th><th>Email</th><th>Phone</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td>@item.FullName</td><td>@item.CompanyName</td><td>@item.Email</td><td>@item.Phone</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> · <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }</tbody></table></div>
@if(Model.Count == 0) { <p>No records yet. Create the first record above.</p> }